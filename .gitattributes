# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicit text files
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.sh text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows-specific scripts
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary artifacts (never perform line-ending normalization)
*.joblib binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.tar.gz binary
*.zip binary
